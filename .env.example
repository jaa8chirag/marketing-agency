# Postgres connection.
# Local dev: matches docker-compose.yml's default credentials (below).
# Production (Vercel): use your provider's POOLED connection string (e.g.
# Neon's "-pooler" hostname), not a direct one — Vercel's serverless
# functions open a new DB connection per invocation, and a direct
# connection string will exhaust Postgres's connection limit under real
# traffic. See docs/DEPLOYMENT.md.
DATABASE_URL="postgresql://cordinit:cordinit_dev_password@localhost:5434/cordinit_media?schema=public"

# Production only — a DIRECT (non-pooled) connection string, same database/
# credentials as DATABASE_URL above but WITHOUT the "-pooler" in the
# hostname. Used only at build time for `prisma migrate deploy` (see
# prisma7.config.ts) — migrations take a session-scoped postgres advisory
# lock that can time out through a pooled/PgBouncer connection (hit this
# exact failure once against Neon: "P1002 ... Timed out trying to acquire a
# postgres advisory lock"). Leave unset locally; docker-compose has no
# pooler so DATABASE_URL alone is fine there.
DIRECT_URL=""

# Admin panel — used only by prisma/seed.ts to create the first admin user.
# Change these before running the seed in any shared/staging/production environment.
ADMIN_EMAIL="admin@cordinitmedia.com"
ADMIN_PASSWORD="change-me-before-seeding"

# Long random string used to sign the admin session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-string"

# Optional — GA4 measurement ID. Analytics script only loads when this is set.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Cal.com scheduling embed — the "Book a Call" flow shows a message instead
# of a calendar until this is set. Format: "your-cal-username/event-slug".
# See docs/CLIENT_HANDOFF.md for what to get from Cal.com.
NEXT_PUBLIC_CAL_LINK=""

# Secret from the same Cal.com event type's Webhooks settings — required to
# verify incoming webhook payloads in app/api/cal-webhook/route.ts. Without
# this set, the webhook endpoint refuses all requests (fails closed).
CAL_WEBHOOK_SECRET=""

# Resend (transactional email) — https://resend.com, free tier is 3,000
# emails/month. Without RESEND_API_KEY set, email sending is skipped
# entirely (logged as a warning, doesn't break form submissions).
RESEND_API_KEY=""
# Must be on a domain verified in your Resend account. Falls back to
# Resend's shared onboarding@resend.dev address (works with zero setup,
# fine for testing) if left unset.
RESEND_FROM_EMAIL=""
# Where internal "new lead" notifications are sent. Falls back to ADMIN_EMAIL if unset.
NOTIFICATION_EMAIL=""
